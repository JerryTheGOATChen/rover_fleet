<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rover_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- These three are the plugins gz-sim loads automatically for a
         plugin-less world. The moment ANY plugin is listed explicitly
         (Sensors, below), the automatic defaults stop being added, so
         they all have to be spelled out here or the world/UserCommands/
         SceneBroadcaster silently disappear too. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <!-- Sensors system: REQUIRED for the lidar to produce any data at all.
         render_engine is "ogre" (the legacy/OGRE1 renderer), not the default
         "ogre2" — ogre2 is documented to crash / silently fail to init under
         WSL2's WSLg OpenGL translation layer, which kills gpu_lidar output
         even though the rest of the sim (physics, driving) runs fine. This
         is the single most common reason a WSL2 gz-sim lidar "does nothing."
         If you later confirm working GPU passthrough and want nicer visuals,
         change this to ogre2. If "ogre" still fails to open a window, force
         pure CPU rendering with: export LIBGL_ALWAYS_SOFTWARE=1 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Enclosed ~8m x 8m room so slam_toolbox actually has walls to close
         loops against - two floating boxes in open ground give the lidar
         almost nothing to work with (mostly "inf" readings) and mapping
         quality/loop closure won't mean much. Room center is at the origin,
         where the robot spawns. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.1 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.4 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- A couple of interior obstacles so the map has distinctive features
         to scan-match against (corners alone can be ambiguous). -->
    <model name="test_box_1">
      <static>true</static>
      <pose>2 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="test_box_2">
      <static>true</static>
      <pose>-1.5 -2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
