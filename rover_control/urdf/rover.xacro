<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       rover.xacro — main robot description

       body_link is the ROOT link (no base_footprint). This matches every
       other config file in the project already using "body_link" as the
       base frame (controllers.yaml, slam_params.yaml, nav2_params.yaml) —
       adding a base_footprint on top would give body_link two TF parents
       (one static from here, one dynamic from the DiffDrive plugin) which
       breaks the TF tree. Keep it simple: body_link IS the base frame.

       Wheel joint naming matches controllers.yaml exactly:
         left  = wheel2_joint, wheel3_joint
         right = wheel1_joint, wheel4_joint
       wheel1 = front-right, wheel2 = front-left,
       wheel3 = rear-left,   wheel4 = rear-right
       ================================================================ -->

  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_separation" value="0.70"/> <!-- must match controllers.yaml -->
  <xacro:property name="wheelbase" value="0.50"/>
  <xacro:property name="chassis_x" value="0.70"/>
  <xacro:property name="chassis_y" value="0.50"/>
  <xacro:property name="chassis_z" value="0.20"/>
  <xacro:property name="chassis_mass" value="10.0"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <material name="chassis_grey"><color rgba="0.35 0.35 0.4 1"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="lidar_orange"><color rgba="0.9 0.45 0.05 1"/></material>

  <!-- ============================ chassis ============================ -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <inertia ixx="0.2417" iyy="0.4417" izz="0.6167" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ============================ wheel macro ============================ -->
  <xacro:macro name="wheel" params="name x_off y_off">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <!-- symmetry axis is Y (rolling axis) -->
        <inertia ixx="0.005925" iyy="0.01125" izz="0.005925" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="body_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x_off} ${y_off} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel1" x_off="${wheelbase/2}"  y_off="${-wheel_separation/2}"/> <!-- front-right -->
  <xacro:wheel name="wheel2" x_off="${wheelbase/2}"  y_off="${wheel_separation/2}"/>  <!-- front-left  -->
  <xacro:wheel name="wheel3" x_off="${-wheelbase/2}" y_off="${wheel_separation/2}"/>  <!-- rear-left   -->
  <xacro:wheel name="wheel4" x_off="${-wheelbase/2}" y_off="${-wheel_separation/2}"/> <!-- rear-right  -->

  <!-- ============================ lidar ============================ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="lidar_orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0000867" iyy="0.0000867" izz="0.00009" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.2 0 ${chassis_z + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo control + sensor plugins (native gz-sim systems, no ros2_control) -->
  <xacro:include filename="$(find rover_control)/urdf/ros2_control.xacro"/>

</robot>
