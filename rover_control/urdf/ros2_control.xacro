<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       ros2_control.xacro

       ARCHITECTURE NOTE — read this before wondering where ros2_control went:

       This file used to define a <ros2_control> hardware interface driven by
       gz_ros2_control, paired with controllers.yaml's diff_drive_controller +
       joint_state_broadcaster. That stack was crashing on this WSL2 setup, so
       the working sim now drives the wheels directly with Gazebo's own
       DiffDrive system plugin, and publishes joint_states with Gazebo's own
       JointStatePublisher system plugin. There is no controller_manager and
       no ros2_control tag in the sim path anymore. controllers.yaml is kept
       in config/ purely as a reference for a possible future ros2_control
       bring-up on the real hardware — it is not loaded by rover_sim.launch.py.
       ================================================================ -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel2_joint</left_joint>
      <left_joint>wheel3_joint</left_joint>
      <right_joint>wheel1_joint</right_joint>
      <right_joint>wheel4_joint</right_joint>

      <wheel_separation>0.70</wheel_separation>
      <wheel_radius>0.15</wheel_radius>

      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>

      <!-- flat gz topic names (no /model/<name>/ prefix) so the bridge config
           in config/rover_bridge.yaml can map them 1:1 -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>body_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel1_joint</joint_name>
      <joint_name>wheel2_joint</joint_name>
      <joint_name>wheel3_joint</joint_name>
      <joint_name>wheel4_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============================ lidar sensor ============================
       IMPORTANT: this sensor produces NOTHING unless the world also loads
       the gz-sim-sensors-system plugin (see worlds/rover_world.sdf). That is
       the #1 reason a lidar "does nothing" in gz-sim even though the URDF
       looks completely correct — Sensors is not one of the plugins gz-sim
       loads by default, unlike Physics/SceneBroadcaster/UserCommands.
       ======================================================================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
