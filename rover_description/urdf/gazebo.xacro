<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       gazebo.xacro — Gazebo plugins, included by rover.urdf.xacro

       The sim drives the wheels with Gazebo's own DiffDrive system plugin
       and publishes joint_states with its JointStatePublisher plugin - no
       ros2_control (gz_ros2_control crashed on this WSL2 setup).
       Nav2's speed limits (nav2.yaml) stay inside the DiffDrive limits below.
       ================================================================ -->

  <xacro:property name="skid_steer_track_factor" value="1.32"/>

  <!-- "" for the single robot, "robot1/" etc. in the fleet (xacro arg ns) -->
  <xacro:property name="ns" value="$(arg ns)"/>
  <xacro:property name="prefix" value="${ns + '/' if ns else ''}"/>
  <xacro:property name="truth_odom" value="${'$(arg odometry)' == 'truth'}"/>
  <!-- Fleet robots carry a mast behind the lidar (rover.urdf.xacro), so their
       scan leaves out the 20 degrees behind: a robot never sees its own mast. -->
  <xacro:property name="lidar_half_fov" value="${2.96706 if ns else 3.14159}"/>
  <xacro:property name="lidar_samples" value="${340 if ns else 360}"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel2_joint</left_joint>
      <left_joint>wheel3_joint</left_joint>
      <right_joint>wheel1_joint</right_joint>
      <right_joint>wheel4_joint</right_joint>

      <!-- Effective track, not the geometric one: a 4-wheel skid-steer
           scrubs sideways when it turns, so it rotates ~1.3x less than
           no-slip kinematics predict. Using the geometric 0.70 m made /odom
           overestimate every turn by ~37% (measured against Gazebo ground
           truth), and SLAM's constant corrections made the map appear to
           spin. -->
      <wheel_separation>${wheel_separation * skid_steer_track_factor}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>

      <!-- flat gz topic names (no /model/<name>/ prefix) so
           rover_bringup/config/gz_bridge.yaml can map them 1:1 -->
      <topic>${prefix}cmd_vel</topic>
      <odom_topic>${prefix}odom</odom_topic>
      <!-- with odometry:=truth this TF goes to an unbridged topic; the
           OdometryPublisher below provides odom -> body_link instead -->
      <tf_topic>${prefix + ('wheel_tf' if truth_odom else 'tf')}</tf_topic>
      <frame_id>${prefix}odom</frame_id>
      <child_frame_id>${prefix}body_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>


    <!-- Keep this plugin even where nothing reads its topic (the fleet doesn't
         bridge it): without it, the DiffDrive odometry above goes badly wrong. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>${prefix}joint_states</topic>
      <joint_name>wheel1_joint</joint_name>
      <joint_name>wheel2_joint</joint_name>
      <joint_name>wheel3_joint</joint_name>
      <joint_name>wheel4_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Fleet only: the robot's true pose in the world. rover_fleet's comms_sim
       uses it for radio range (it depends on where robots really are). With
       odometry:=truth it is also the robot's odom -> body_link (so odom = world);
       SLAM still builds each robot's map from its own lidar. -->
  <xacro:if value="${ns != ''}">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>${prefix + 'odom' if truth_odom else 'world'}</odom_frame>
        <robot_base_frame>${prefix}body_link</robot_base_frame>
        <odom_topic>${prefix}ground_truth</odom_topic>
        <tf_topic>${prefix + ('tf' if truth_odom else 'ground_truth_tf')}</tf_topic>
        <odom_publish_frequency>${50 if truth_odom else 10}</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ============================ lidar sensor ============================
       IMPORTANT: this sensor produces NOTHING unless the world also loads
       the gz-sim-sensors-system plugin (see rover_bringup/worlds/rover_world.sdf). That is
       the #1 reason a lidar "does nothing" in gz-sim even though the URDF
       looks completely correct — Sensors is not one of the plugins gz-sim
       loads by default, unlike Physics/SceneBroadcaster/UserCommands.
       ======================================================================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>${prefix}scan</topic>
      <!-- Without this, gz stamps scans with its scoped name
           "rover/body_link/lidar" (the URDF->SDF conversion merges
           fixed-joint links into body_link), which isn't in the TF tree -
           so slam_toolbox, Nav2 and RViz silently drop every scan. -->
      <gz_frame_id>${prefix}lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-lidar_half_fov}</min_angle>
            <max_angle>${lidar_half_fov}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
