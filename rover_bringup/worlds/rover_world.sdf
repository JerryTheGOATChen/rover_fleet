<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rover_world">
    <!-- A 16 m x 12 m single-storey house: living room, kitchen and two
         bedrooms, with furniture for SLAM features and Nav2 obstacles.
         Models are named by room below. The rover spawns at the world
         origin, the open center of the living room. -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- These three are the plugins gz-sim loads automatically for a
         plugin-less world. The moment ANY plugin is listed explicitly
         (Sensors, below), the automatic defaults stop being added, so
         they all have to be spelled out here or the world/UserCommands/
         SceneBroadcaster silently disappear too. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <!-- Sensors system: REQUIRED for the lidar to produce any data at all.
         render_engine is "ogre" (the legacy/OGRE1 renderer), not the default
         "ogre2" — ogre2 is documented to crash / silently fail to init under
         WSL2's WSLg OpenGL translation layer, which kills gpu_lidar output
         even though the rest of the sim (physics, driving) runs fine. This
         is the single most common reason a WSL2 gz-sim lidar "does nothing."
         If you later confirm working GPU passthrough and want nicer visuals,
         change this to ogre2. If "ogre" still fails to open a window, force
         pure CPU rendering with: export LIBGL_ALWAYS_SOFTWARE=1 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: 16 m x 12 m house (house coords x -8..8, y -6..6) -->
    <model name="wall_outer_north"><static>true</static>
      <pose>3.00 7.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>16.20 0.20 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.20 0.20 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_outer_south"><static>true</static>
      <pose>3.00 -4.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>16.20 0.20 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.20 0.20 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_outer_west"><static>true</static>
      <pose>-5.00 1.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.20 12.00 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 12.00 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_outer_east"><static>true</static>
      <pose>11.00 1.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.20 12.00 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 12.00 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>

    <!-- Interior walls. Doorways are 1.5-2.0 m: the rover is 0.80 m x 0.76 m and Nav2 keeps 0.7 m of inflation around walls -->
    <model name="wall_mid_a"><static>true</static>
      <pose>-3.85 2.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.10 0.20 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.10 0.20 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_mid_b"><static>true</static>
      <pose>2.60 2.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.20 0.20 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.20 0.20 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_mid_c"><static>true</static>
      <pose>9.45 2.50 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.90 0.20 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.90 0.20 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_bedrooms"><static>true</static>
      <pose>3.00 5.00 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.20 4.80 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 4.80 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_kitchen_a"><static>true</static>
      <pose>5.00 -3.55 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.20 1.70 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 1.70 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>
    <model name="wall_kitchen_b"><static>true</static>
      <pose>5.00 0.10 0.600 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.20 1.60 1.20</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 1.60 1.20</size></box></geometry>
          <material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
      </link></model>

    <!-- Living room (house x -8..2, y -6..1) - the rover spawns in its open center.
         Every gap is either >= 1.5 m (passable) or < 0.6 m (closed): the rover
         is 0.80 m x 0.76 m, and anything in between is a gap Nav2 will try and
         the rover will get stuck in. -->
    <model name="couch"><static>true</static>
      <pose>0.00 -3.80 0.400 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.20 0.90 0.80</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.20 0.90 0.80</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link></model>
    <model name="coffee_table"><static>true</static>
      <pose>0.00 -2.30 0.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.20 0.60 0.50</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.20 0.60 0.50</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="armchair"><static>true</static>
      <pose>-2.00 -3.40 0.400 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.90 0.90 0.80</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.90 0.90 0.80</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link></model>
    <model name="tv_stand"><static>true</static>
      <pose>-4.60 -1.00 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.40 1.80 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.40 1.80 0.60</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
      </link></model>
    <model name="bookshelf"><static>true</static>
      <pose>-4.60 1.50 0.900 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.40 1.40 1.80</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.40 1.40 1.80</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="dining_table"><static>true</static>
      <pose>2.00 1.50 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.20 0.80 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.20 0.80 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="plant_living"><static>true</static>
      <pose>4.40 -3.90 0.500 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.20 0.50 0.25 1</ambient><diffuse>0.20 0.50 0.25 1</diffuse></material></visual>
      </link></model>

    <!-- Kitchen (house x 2..8, y -6..1) -->
    <model name="counter_east"><static>true</static>
      <pose>10.55 -1.80 0.450 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.70 4.80 0.90</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.70 4.80 0.90</size></box></geometry>
          <material><ambient>0.65 0.65 0.62 1</ambient><diffuse>0.65 0.65 0.62 1</diffuse></material></visual>
      </link></model>
    <model name="counter_south"><static>true</static>
      <pose>7.60 -4.05 0.450 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.00 0.70 0.90</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.00 0.70 0.90</size></box></geometry>
          <material><ambient>0.65 0.65 0.62 1</ambient><diffuse>0.65 0.65 0.62 1</diffuse></material></visual>
      </link></model>
    <model name="kitchen_island"><static>true</static>
      <pose>7.60 -1.50 0.450 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.20 0.70 0.90</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.20 0.70 0.90</size></box></geometry>
          <material><ambient>0.65 0.65 0.62 1</ambient><diffuse>0.65 0.65 0.62 1</diffuse></material></visual>
      </link></model>
    <model name="fridge"><static>true</static>
      <pose>10.50 1.95 0.900 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.80 0.70 1.80</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.80 0.70 1.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      </link></model>

    <!-- Bedroom 1 (house x -8..0, y 1..6), door from the living room -->
    <model name="bed_1"><static>true</static>
      <pose>1.00 6.40 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.60 2.00 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.60 2.00 0.60</size></box></geometry>
          <material><ambient>0.70 0.30 0.35 1</ambient><diffuse>0.70 0.30 0.35 1</diffuse></material></visual>
      </link></model>
    <model name="nightstand_1"><static>true</static>
      <pose>2.45 7.05 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.50 0.50 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.50 0.50 0.60</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="wardrobe"><static>true</static>
      <pose>-2.00 7.10 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.80 0.60 2.00</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.80 0.60 2.00</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="desk"><static>true</static>
      <pose>-4.55 5.00 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.70 1.40 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.70 1.40 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>

    <!-- Bedroom 2 (house x 0..8, y 1..6), door from the kitchen -->
    <model name="bed_2"><static>true</static>
      <pose>10.00 6.40 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.60 2.00 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.60 2.00 0.60</size></box></geometry>
          <material><ambient>0.70 0.30 0.35 1</ambient><diffuse>0.70 0.30 0.35 1</diffuse></material></visual>
      </link></model>
    <model name="dresser"><static>true</static>
      <pose>4.20 7.15 0.500 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.20 0.50 1.00</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.20 0.50 1.00</size></box></geometry>
          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="storage_box"><static>true</static>
      <pose>10.45 3.00 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.60 0.60 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.60 0.60 0.60</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
      </link></model>
    <model name="laundry_basket"><static>true</static>
      <pose>3.50 3.00 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      </link></model>

  </world>
</sdf>
