<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Pulls in body_link/wheel1-4_link/lidar_link plus the <gazebo> DiffDrive
       and gpu_lidar sensor tags from rover_control. Those <gazebo> tags are
       simply inert here - nothing on real hardware reads them, since gz-sim
       isn't running. robot_state_publisher only cares about <link>/<joint>,
       and the real RPLIDAR C1 driver (sllidar_ros2) doesn't read the URDF at
       all, it just needs the static lidar_link -> body_link TF this already
       provides. So reusing rover.xacro unmodified is safe, not a hack. -->
  <xacro:include filename="$(find rover_control)/urdf/rover.xacro"/>

  <!-- The real <ros2_control> hardware block, additional to the above. -->
  <xacro:include filename="$(find rover_hardware)/urdf/rover_hardware.ros2_control.xacro"/>

</robot>
